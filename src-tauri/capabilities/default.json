{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Everything the main window is allowed to call. Only plugins the app actually ships are listed.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "dialog:default",
    "opener:default",
    "clipboard-manager:allow-write-text",
    "updater:default",
    "process:default"
  ]
}
