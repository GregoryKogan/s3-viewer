{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "S3 Viewer",
  "version": "0.3.0",
  "identifier": "dev.s3viewer.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "S3 Viewer",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "dragDropEnabled": true,
        "minimizable": true,
        "maximizable": true,
        "closable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' s3stream: data: blob:; media-src 'self' s3stream: blob:; frame-src 'self' s3stream: blob:; connect-src 'self' ipc: http://ipc.localhost s3stream:; font-src 'self' data:; object-src 'none'; base-uri 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "S3 browser with built-in preview",
    "longDescription": "A focused S3 client: saved connections with boto3-compatible settings, an object browser, rich in-app preview (images, audio, video, PDF, text, Markdown, code) and the usual file operations. Credentials are stored encrypted on the local machine.",
    "copyright": "© 2026",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzMDdGNkFBNzMzNjQ5RTEKUldUaFNUWnpxdllIRTRrU0FMdEJFNzY5ZUdic0R5cm9UVy9QQm0zdVJWYnprOFhQWENib05yY20K",
      "endpoints": [
        "https://github.com/GregoryKogan/s3-viewer/releases/latest/download/latest.json"
      ]
    }
  }
}
