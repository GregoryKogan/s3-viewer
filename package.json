{
  "name": "s3-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal, fast S3 browser with rich in-app preview. macOS + Linux.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:frontend": "vite build",
    "dev": "pnpm build:frontend && pnpm tauri dev",
    "app:build": "pnpm build:frontend && pnpm tauri build",
    "app:build:debug": "pnpm build:frontend && pnpm tauri build --debug",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:js": "node --test tests/js",
    "test:e2e": "node e2e/run.mjs",
    "check": "pnpm build:frontend && cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml",
    "type-check": "vue-tsc --noEmit",
    "dev:frontend": "vite build --watch"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.9.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "esbuild": "^0.25.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  },
  "dependencies": {
    "@lucide/vue": "^1.57.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "pinia": "^4.1.0",
    "vue": "^3.5.44"
  }
}
